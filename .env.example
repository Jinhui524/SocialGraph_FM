# The unified scripts inject absolute runtime paths below the repository var tree.
# Do not set SOCIALGRAPH_FM_HOME to a relative path.
SOCIALGRAPH_GOVERNANCE_WEB_PORT=5173
SOCIALGRAPH_CORE_API_PORT=8000
SOCIALGRAPH_GFM_PORT=8766

# Governance Web -> Torch-free Core API. Safe for browser builds.
VITE_SOCIALGRAPH_API_BASE_URL=http://127.0.0.1:8000

# Private LLM configuration belongs in var/config/socialgraph-api.env. Only these
# server-side names are imported: LLM_API_BASE, LLM_API_KEY, LLM_MODEL,
# LLM_API_MODE, LLM_AUTH_SCHEME, LLM_ANTHROPIC_VERSION,
# LLM_TIMEOUT_SECONDS, LLM_ALLOW_INSECURE_LOOPBACK,
# LLM_VERIFICATION_STATUS, and optional LOG_LEVEL.
# scripts/configure-llm.ps1 writes these values atomically and restricts the
# private directory ACL. Never put a real key in this tracked example.

# GFM serving identity, token, control, dataset, Research, Governance, and cache paths are launcher-owned.
# A running GFM process does not imply that a servingReady model has been promoted.
# SocialGraph-FM Governance defaults: 256 MiB compressed, 1 GiB expanded, 10,000 nodes, 500,000 relations.
