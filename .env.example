# Optional local port overrides. Ordinary users do not need this file.
SOCIALGRAPH_PUBLIC_PORT=5173
SOCIALGRAPH_GFM_PORT=8766

# The required private LLM configuration is written only to
# var/config/socialgraph-api.env by `python scripts/socialgraph.py onboard` or
# `configure-llm`. It contains exactly LLM_API_BASE, LLM_MODEL, and LLM_API_KEY.
# Never put a real key in this tracked example or in the process environment.

# Runtime, Web, model, token, dataset, Governance, and user-state paths are
# launcher-owned below var/.
