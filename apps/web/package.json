{
  "name": "socialgraph-fm-web",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:governance-skills": "node scripts/generate-governance-skill-contract.mjs",
    "check:governance-skills": "node scripts/generate-governance-skill-contract.mjs --check",
    "typecheck": "npm run check:governance-skills && tsc --noEmit",
    "test": "npm run check:governance-skills && vitest run",
    "build:e2e": "vite build --mode e2e",
    "test:e2e": "npm run build:e2e && playwright test",
    "test:e2e:offline": "npm run build:e2e && playwright test --grep-invert @backend",
    "test:e2e:nonrelease": "playwright test --grep-invert \"managed governance release gate\"",
    "test:e2e:governance-live": "playwright test governance-live-system.spec.ts",
    "test:benchmark-runner": "node --test tests/benchmark-watchdog.test.mjs",
    "build": "vite build",
    "benchmark:graph": "npm run build && node scripts/run-graph-benchmark.mjs",
    "benchmark:graph:smoke": "npm run build && node scripts/run-graph-benchmark.mjs --smoke",
    "benchmark:graph:profile": "npm run build && node scripts/run-graph-benchmark.mjs --smoke --profile=canvas",
    "benchmark:graph:hybrid:smoke": "npm run build && node scripts/run-graph-benchmark.mjs --smoke --renderer=hybrid-webgl --gate-renderer=hybrid-webgl",
    "benchmark:graph:renderers": "npm run build && node scripts/run-graph-benchmark.mjs --renderers=canvas,hybrid-webgl,auto --gate-renderer=hybrid-webgl",
    "benchmark:graph:gpu": "npm run build && node scripts/run-graph-benchmark.mjs --renderer=hybrid-webgl --gate-renderer=hybrid-webgl --probe=gpu",
    "benchmark:graph:promotion": "npm run build && node scripts/run-graph-promotion.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@antv/g-canvas": "2.2.0",
    "@antv/g-webgl": "2.1.1",
    "@antv/g6": "^5.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "dexie": "^4.4.4",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "papaparse": "^5.7.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vite": "6.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
