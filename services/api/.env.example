# Reference only. The unified launcher does not load a source-tree .env file.
# Use ../../scripts/configure-llm.ps1; never commit a real API key.
LLM_API_BASE=https://api.example.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-me
LLM_API_MODE=chat_completions
LLM_AUTH_SCHEME=bearer
LLM_ANTHROPIC_VERSION=
LLM_TIMEOUT_SECONDS=15
LLM_VERIFICATION_STATUS=configured_unverified
# Keep false for remote providers. Set true only with an HTTP loopback API Base.
LLM_ALLOW_INSECURE_LOOPBACK=false
DATASET_UPLOAD_MAX_BYTES=20971520
DATASET_ARCHIVE_MAX_BYTES=52428800
DATASET_ARCHIVE_MAX_FILES=100
# The unified root launcher injects an absolute path below <repository>\var.
DATASET_STORAGE_ROOT=artifacts/dataset-store
INSPECTION_CACHE_TTL_SECONDS=900
INSPECTION_CACHE_MAX_BYTES=536870912
# Resource-budget scope only; X-SocialGraph-Project-ID is not authentication or tenancy.
INSPECTION_CACHE_MAX_PROJECT_BYTES=268435456
INSPECTION_CACHE_MAX_ENTRY_BYTES=134217728
RUNTIME_BUILD_ID=dev
LOCAL_DEMO_LOOPBACK_ONLY=true
# The unified root launcher injects these absolute paths while the isolated service runs.
GFM_SERVICE_URL=
GFM_SESSION_TOKEN_FILE=
GFM_CORE_SERVING_CONTROL_FILE=
GFM_CORE_RUN_BINDING_ROOT=
GFM_CORE_SERVING_HIGH_WATER_ROOT=
# Optional API-owned SocialGraph-FM Research run bindings; defaults beside the formal bindings.
GFM_RESEARCH_RUN_BINDING_ROOT=
# Optional API-owned SocialGraph-FM Global immutable run bindings and human-review records.
GFM_GLOBAL_MODEL_RUN_BINDING_ROOT=
GFM_GLOBAL_MODEL_REVIEW_ROOT=
# Shared API/GFM Governance root; launcher sets <repository>\var\gfm\governance.
GFM_GOVERNANCE_ROOT=
GFM_GOVERNANCE_BUNDLE_MAX_BYTES=268435456
GFM_GOVERNANCE_EXPANDED_MAX_BYTES=1073741824
GFM_GOVERNANCE_CONFIRMATION_TTL_SECONDS=300
GFM_TIMEOUT_SECONDS=5
GFM_REQUEST_MAX_BYTES=262144
GRAPH_HANDOFF_TOKEN_TTL_SECONDS=300
# Trusted-local conversion is disabled unless all three lines below are configured.
ENABLE_TRUSTED_LOCAL_CONVERSION=false
TRUSTED_DATA_ROOTS=
# Point this at a separate research Python environment containing PyTorch/SciPy.
TRUSTED_CONVERTER_PYTHON=
TRUSTED_CONVERSION_TIMEOUT_SECONDS=900
TRUSTED_CONVERSION_MAX_FILES=10000
TRUSTED_CONVERSION_MAX_SOURCE_BYTES=10737418240
TRUSTED_CONVERSION_MAX_OUTPUT_BYTES=4294967296
TRUSTED_CONVERSION_MEMORY_MB=4096
TRUSTED_ARRAY_MAX_BYTES=2147483648
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
LOG_LEVEL=INFO
