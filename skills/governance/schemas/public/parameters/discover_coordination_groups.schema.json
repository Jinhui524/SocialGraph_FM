{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socialgraph-fm.local/schemas/governance/public/parameters/discover_coordination_groups.schema.json",
  "title": "discover_coordination_groups parameters",
  "type": "object",
